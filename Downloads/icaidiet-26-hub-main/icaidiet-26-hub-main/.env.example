# Email Configuration Examples

# Choose ONE of the following email services:

# 1. RESEND (Recommended for serverless)
# Get your API key from https://resend.com
RESEND_API_KEY=re_xxx_your_key_here

# 2. SENDGRID
# Get your API key from https://sendgrid.com
SENDGRID_API_KEY=SG.xxx_your_key_here

# 3. MAILGUN
# Get your credentials from https://www.mailgun.com
MAILGUN_API_KEY=key-xxx_your_key_here
MAILGUN_DOMAIN=mail.example.com

# Common configuration for all services
SMTP_FROM_EMAIL=noreply@icaidiet26.tech
CONTACT_EMAIL=icaidiet26@gmail.com
REGISTRATION_EMAIL=kvenkateshk2004@gmail.com

# For local development, if you don't configure any email service,
# emails will be logged to the console instead.
